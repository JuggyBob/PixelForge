<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="product_version" required="true" />
    <parameter name="file_version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="PixelForge.exe"
             product-name="PixelForge"
             product-version="${product_version}"
             file-version="${file_version}"
             company-name="PixelForge"
             copyright="Copyright (c) 2026 PixelForge">
      <authenticode-sign description="PixelForge"
                         description-url="https://github.com/JuggyBob/PixelForge" />
    </pe-file>
  </zip-file>
</artifact-configuration>
