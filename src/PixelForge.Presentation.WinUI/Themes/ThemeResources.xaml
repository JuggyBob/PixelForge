<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppSolidBackgroundBrush" Color="#F6F7F9" />
            <SolidColorBrush x:Key="AppMicaTintBrush" Color="#DDF6F7F9" />
            <SolidColorBrush x:Key="SidebarTintBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="TitleBarTintBrush" Color="#B3F6F7F9" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SubtleSurfaceHoverBrush" Color="#14000000" />
            <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#0B000000" />
            <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#2E000000" />
            <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="StatusBarBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#1B7A3D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9A5B00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="InfoBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1A1B7A3D" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#1A9A5B00" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1AB42318" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#1A0F6CBD" />
            <SolidColorBrush x:Key="StatusChipBackgroundBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="ComparisonBackgroundBrush" Color="#E9ECEF" />
            <AcrylicBrush x:Key="GlassPanelBrush"
                          TintColor="#F6F7F9" TintOpacity="0.90" FallbackColor="#F6F7F9" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppSolidBackgroundBrush" Color="#0E1318" />
            <SolidColorBrush x:Key="AppMicaTintBrush" Color="#CC0E1318" />
            <SolidColorBrush x:Key="SidebarTintBrush" Color="#8F0B1015" />
            <SolidColorBrush x:Key="TitleBarTintBrush" Color="#B30E1318" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="SubtleSurfaceHoverBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="StatusBarBrush" Color="#B30B1015" />
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#99000000" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#5BE49B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F7C948" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF9B8E" />
            <SolidColorBrush x:Key="InfoBrush" Color="#7CC4FF" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1A5BE49B" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#1AF7C948" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1AFF9B8E" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#1A7CC4FF" />
            <SolidColorBrush x:Key="StatusChipBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComparisonBackgroundBrush" Color="#151B21" />
            <AcrylicBrush x:Key="GlassPanelBrush"
                          TintColor="#0E1318" TintOpacity="0.90" FallbackColor="#0E1318" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppSolidBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppMicaTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SidebarTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TitleBarTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SubtleSurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DropZoneBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StatusChipBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ComparisonBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Consolas</FontFamily>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#D2693A" />
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#A8491F" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#BD5628" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#8C3A17" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A8491F" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#24D2693A" />
    <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#66D2693A" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#33D2693A" />
    <x:Double x:Key="AppBodyFontSize">14</x:Double>
    <x:Double x:Key="AppBodyLineHeight">20</x:Double>
    <x:Double x:Key="AppCaptionFontSize">12</x:Double>
    <x:Double x:Key="AppScale">1.0</x:Double>
    <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
    <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
</ResourceDictionary>
