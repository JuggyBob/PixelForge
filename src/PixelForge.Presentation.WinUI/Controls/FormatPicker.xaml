<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PixelForge.Presentation.Controls.FormatPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PixelForge.Presentation.Localization"
    HorizontalContentAlignment="Stretch">

    <Grid>
        <Button x:Name="PickerButton" Style="{StaticResource SecondaryButtonStyle}"
                Padding="10,7" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                loc:Loc.AutomationName="Output format"
                AutomationProperties.AutomationId="OutputFormatPicker">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource AccentSubtleBrush}" BorderBrush="{ThemeResource AccentSubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                    <TextBlock x:Name="ExtensionText" loc:Loc.Text="PNG" FontFamily="{ThemeResource AppMonoFontFamily}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" loc:Loc.Text="Choose a format" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HintText" loc:Loc.Text="Searchable format catalogue" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="11"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="PickerFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFlyoutOpening"
                        Closed="OnFlyoutClosed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="10" MinWidth="430" MaxWidth="560" MaxHeight="440">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchBox" loc:Loc.Placeholder="Search extension or format name…"
                                     TextChanged="OnSearchTextChanged" KeyDown="OnSearchBoxKeyDown"
                                     loc:Loc.AutomationName="Search output formats"
                                     AutomationProperties.AutomationId="FormatSearchBox" />
                            <ListView x:Name="FormatList" Grid.Row="1" MaxHeight="300" SelectionMode="Single"
                                      IsItemClickEnabled="True" ItemClick="OnFormatClicked"
                                      KeyDown="OnFormatListKeyDown"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                    </TransitionCollection>
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10" Padding="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="5" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExtensionUpper, Converter={StaticResource Localize}}" FontFamily="{ThemeResource AppMonoFontFamily}"
                                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource Localize}}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Badges, Converter={StaticResource Localize}}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CategoryText, Converter={StaticResource Localize}}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="NoResultsText" Grid.Row="1" loc:Loc.Text="No matching formats"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                            <TextBlock x:Name="FooterText" Grid.Row="2" loc:Loc.Text="Only formats supported by the installed engines are listed."
                                       FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
