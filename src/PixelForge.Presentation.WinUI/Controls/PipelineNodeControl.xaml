<UserControl
    x:Class="PixelForge.Presentation.Controls.PipelineNodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:PixelForge.Presentation.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="PipelineInputFileTemplate">
            <Grid ColumnSpacing="8" Padding="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="6"
                        Background="{ThemeResource SubtleSurfaceBrush}">
                    <Grid>
                        <FontIcon Glyph="{Binding TypeGlyph}"
                                  FontFamily="{ThemeResource IconFontFamily}"
                                  FontSize="14" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Tag="{Binding}"
                        Click="OnRemoveInputFileClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="6"
                        loc:Loc.ToolTip="Remove"
                        loc:Loc.AutomationName="Remove">
                    <FontIcon Glyph="&#xE711;"
                              FontFamily="{ThemeResource IconFontFamily}"
                              FontSize="10" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Width="280">
        <Border x:Name="Card"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <Grid x:Name="Header" Height="64" Padding="12,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="9"
                            Background="{ThemeResource AccentSubtleBrush}"
                            VerticalAlignment="Center">
                        <FontIcon x:Name="Icon"
                                  FontFamily="{ThemeResource IconFontFamily}"
                                  FontSize="18"
                                  Glyph="&#xE8AB;" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="TitleText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SummaryText"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <FontIcon x:Name="ExpandGlyph"
                                  FontFamily="{ThemeResource IconFontFamily}"
                                  FontSize="11"
                                  Glyph="&#xE70D;" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="SettingsHost"
                                Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </Border>

        <Ellipse x:Name="InputPort" Width="12" Height="12"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-6,26,0,0"
                 Fill="{ThemeResource AccentPrimaryBrush}"
                 Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                 StrokeThickness="2"
                 Visibility="Collapsed" />
        <Ellipse x:Name="OutputPort" Width="12" Height="12"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,26,-6,0"
                 Fill="{ThemeResource AccentPrimaryBrush}"
                 Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                 StrokeThickness="2"
                 Visibility="Collapsed" />
    </Grid>
</UserControl>
