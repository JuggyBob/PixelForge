<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PixelForge.Presentation.Controls.ModelManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="24,18,24,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding BackCommand}" VerticalAlignment="Center" Margin="0,0,2,0"
                    Visibility="{Binding IsPanelMode, Converter={StaticResource InverseBoolToVisibility}}"
                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock Grid.Column="1" Text="AI Models" Style="{StaticResource PageTitleTextStyle}"
                       VerticalAlignment="Center" AutomationProperties.AutomationId="ModelsTitle" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshModelsCommand}" ToolTipService.ToolTip="Refresh model list"
                        AutomationProperties.Name="Refresh model list">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ClosePanelCommand}"
                        Visibility="{Binding IsPanelMode, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="Close model panel" AutomationProperties.Name="Close model panel"
                        AutomationProperties.AutomationId="ModelsClosePanel">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="One verified model library for image upscaling, video frames, interpolation and OCR."
                   Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" MaxLines="2"
                   TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Open folder" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenFolderCommand}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="Change folder" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ChooseFolderCommand}" HorizontalAlignment="Stretch" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Show" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" MinWidth="40" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                      DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Model category filter" AutomationProperties.AutomationId="ModelCategoryFilter" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource InsetCardStyle}" Padding="12,9">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="15" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ModelDirectory}" FontFamily="{ThemeResource AppMonoFontFamily}"
                           FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding BusyStatus}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <InfoBar Grid.Row="5" IsOpen="True" Severity="Informational" Title="Local AI, explicit downloads"
                 Message="Weights are not bundled in the installer. Downloads are SHA-256 verified before installation; after that, inference never needs a network connection."
                 IsClosable="False" />

        <ListView Grid.Row="6" ItemsSource="{Binding VisibleModels}" SelectionMode="None" Padding="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="ModelList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SectionCardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource AccentSubtleBrush}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="{ThemeResource AccentTextBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Version}" FontSize="11" MaxLines="1" TextWrapping="NoWrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding Tags}" FontSize="11" MaxLines="1" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"
                                                 Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                        <Ellipse Width="7" Height="7" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                                 Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinWidth="56" TextAlignment="Right" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Architecture}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding IntendedUse}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ScaleText}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="5" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="5" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>

                            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Model operation failed" Message="{Binding Error}"
                                     IsClosable="False" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Download" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DownloadCommand}"
                                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Install from file" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding InstallFromFileCommand}"
                                        Visibility="{Binding CanInstallFromFile, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Validate" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ValidateCommand}"
                                        Visibility="{Binding CanValidate, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Remove" Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveCommand}"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Expander Header="Model details" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="5" Padding="4,6">
                                    <TextBlock Text="{Binding InstalledDetail}" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Task" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding TaskText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Runtime" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding RuntimeBackend}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Provider" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProviderSupport}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Verified" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding VerificationStatus}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="Source" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SourceUrl}" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="SHA-256" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding Hash}" Style="{StaticResource MonoTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LicenseName}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding LicenseDetail}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
