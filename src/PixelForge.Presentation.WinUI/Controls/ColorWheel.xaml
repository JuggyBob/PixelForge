<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PixelForge.Presentation.Controls.ColorWheel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="WheelRoot"
          Width="210" Height="210"
          Background="Transparent"
          IsTabStop="True"
          UseSystemFocusVisuals="True"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerCaptureLost"
          KeyDown="OnKeyDown"
          AutomationProperties.Name="Colour wheel"
          AutomationProperties.HelpText="Choose hue and saturation. Arrow keys adjust the selected colour.">
        <Canvas x:Name="WheelCanvas" Width="200" Height="200"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" />
        <Ellipse Width="200" Height="200"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                     RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Canvas Width="210" Height="210" IsHitTestVisible="False">
            <Ellipse x:Name="Marker" Width="14" Height="14"
                     Stroke="White" StrokeThickness="2"
                     Fill="Transparent" Canvas.Left="98" Canvas.Top="98" />
        </Canvas>
    </Grid>
</UserControl>
