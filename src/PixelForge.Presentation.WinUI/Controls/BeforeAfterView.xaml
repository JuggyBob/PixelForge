<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PixelForge.Presentation.Controls.BeforeAfterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PixelForge.Presentation.Localization"
    Background="Transparent">

    <Grid x:Name="Viewport" Background="{ThemeResource ComparisonBackgroundBrush}"
          PointerPressed="OnViewportPointerPressed" PointerMoved="OnViewportPointerMoved"
          PointerReleased="OnViewportPointerReleased" PointerWheelChanged="OnViewportPointerWheelChanged"
          SizeChanged="OnViewportSizeChanged"
          ManipulationMode="None">
        <Image x:Name="Checkerboard" Source="ms-appx:///Assets/Checker.png" Stretch="Fill" IsHitTestVisible="False" Opacity="0.65" />
        <Canvas x:Name="Scene" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                RenderTransformOrigin="0,0">
            <Canvas.RenderTransform>
                <CompositeTransform x:Name="SceneTransform" ScaleX="1" ScaleY="1" TranslateX="0" TranslateY="0" />
            </Canvas.RenderTransform>
            <Image x:Name="AfterImage" Stretch="Fill" />
            <Image x:Name="BeforeImage" Stretch="Fill" />
        </Canvas>

        <Canvas x:Name="Overlay">
            <Border x:Name="DividerLine" Width="2" Background="{ThemeResource AccentPrimaryBrush}" />
            <Border x:Name="DividerGrip" Width="30" Height="50" CornerRadius="15" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1" IsHitTestVisible="True"
                    PointerPressed="OnDividerPressed" PointerMoved="OnDividerMoved" PointerReleased="OnDividerReleased">
                <FontIcon Glyph="&#xE8AB;" FontSize="13" Foreground="{ThemeResource AccentTextBrush}" />
            </Border>
        </Canvas>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="8,4"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False">
            <TextBlock loc:Loc.Text="Original" FontSize="11" FontWeight="SemiBold" />
        </Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="8,4"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False">
            <TextBlock loc:Loc.Text="Upscaled" FontSize="11" FontWeight="SemiBold" />
        </Border>

        <TextBlock x:Name="EmptyText" loc:Loc.Text="Choose an original and a processed image to compare."
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
