<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelForge.Presentation.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PixelForge.Presentation.Localization"
    Background="Transparent">

    <Grid Padding="28,22,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock loc:Loc.Text="History" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="HistoryTitle" />
                <TextBlock loc:Loc.Text="A searchable local record of processed files — without storing copies of your media."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox" Width="270" Height="34" VerticalAlignment="Center"
                                loc:Loc.Placeholder="Search history…" QueryIcon="Find"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                loc:Loc.AutomationName="Search history" AutomationProperties.AutomationId="HistorySearch" />
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          DisplayMemberPath="DisplayLabel" MinWidth="160" Height="34" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          DisplayMemberPath="DisplayLabel" MinWidth="130" Height="34" VerticalAlignment="Center" />
                <Button loc:Loc.Content="Export" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportHistoryCommand}"
                        AutomationProperties.AutomationId="HistoryExport" />
                <Button loc:Loc.Content="Import" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportHistoryCommand}"
                        AutomationProperties.AutomationId="HistoryImport" />
                <Button Style="{StaticResource IconButtonStyle}" Height="34" Width="34" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" loc:Loc.ToolTip="Refresh history">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button loc:Loc.Content="Clear" Style="{StaticResource DangerButtonStyle}" Command="{Binding ClearCommand}"
                        AutomationProperties.AutomationId="HistoryClear" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="{Binding ResultSummary, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            <ProgressRing IsActive="{Binding IsLoading}" Width="16" Height="16" HorizontalAlignment="Right"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="30">
                    <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="28" />
                    </Border>
                    <TextBlock loc:Loc.Text="No history yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock loc:Loc.Text="Processed files will appear here with their settings and verification details."
                               Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <ListView ItemsSource="{Binding Items}" SelectionMode="None"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="12,10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="38" Height="38" CornerRadius="8" VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title, Converter={StaticResource Localize}}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding InputName, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                    <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding OperationText, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProviderText, Converter={StaticResource Localize}}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding ProviderText, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{Binding ModelText, Converter={StaticResource Localize}}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding ModelText, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{Binding ErrorText, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" MinWidth="112">
                                <TextBlock Text="{Binding FormatText, Converter={StaticResource Localize}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SizeText, Converter={StaticResource Localize}}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center" MinWidth="100">
                                <TextBlock Text="{Binding TimeText, Converter={StaticResource Localize}}" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding DurationText, Converter={StaticResource Localize}}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" MinWidth="66" HorizontalAlignment="Right">
                                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SuccessBrush}"
                                          Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource DangerBrush}"
                                          Visibility="{Binding IsSuccess, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="{Binding StatusText, Converter={StaticResource Localize}}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenCommand}" loc:Loc.ToolTip="Open output"
                                        loc:Loc.AutomationName="Open output">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RevealCommand}" loc:Loc.ToolTip="Show in folder"
                                        loc:Loc.AutomationName="Show in folder">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RepeatCommand}" loc:Loc.ToolTip="Repeat operation"
                                        loc:Loc.AutomationName="Repeat operation">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CompareCommand}"
                                        Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}"
                                        loc:Loc.ToolTip="Compare before and after" loc:Loc.AutomationName="Compare before and after">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
