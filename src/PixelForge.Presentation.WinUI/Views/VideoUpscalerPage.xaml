<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelForge.Presentation.Views.VideoUpscalerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PixelForge.Presentation.Localization"
    xmlns:controls="using:PixelForge.Presentation.Controls"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    Background="Transparent">

    <Grid Padding="28,22,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock loc:Loc.Text="Video Upscaler" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="VideoUpscalerTitle" />
                <TextBlock loc:Loc.Text="Increase resolution with AI, raise the frame rate with RIFE interpolation, or do both in one local job."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock loc:Loc.Text="AI video · local processing" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- Inputs -->
            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:ResponsiveHeaderPanel ColumnSpacing="10" RowSpacing="6">
                        <Grid ColumnSpacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock loc:Loc.Text="Input videos" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource FormatBadgeStyle}">
                                <TextBlock Text="{Binding Files.Count, Converter={StaticResource Localize}}" FontSize="11" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button loc:Loc.Content="Scan folder" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseFolderCommand}" AutomationProperties.AutomationId="VideoUpscalerAddFolder" />
                            <Button loc:Loc.Content="Add videos" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseVideosCommand}" AutomationProperties.AutomationId="VideoUpscalerAddVideos" />
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ClearFilesCommand}"
                                    loc:Loc.ToolTip="Clear workspace" loc:Loc.AutomationName="Clear video workspace"
                                    AutomationProperties.AutomationId="VideoUpscalerClear">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </controls:ResponsiveHeaderPanel>

                    <StackPanel Grid.Row="1" Spacing="6">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox loc:Loc.Content="Include subfolders" MinHeight="0" VerticalAlignment="Center"
                                      IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                                      loc:Loc.AutomationName="Include subfolders" />
                            <ProgressRing Grid.Column="1" IsActive="{Binding IsScanning}" Width="16" Height="16"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <InfoBar IsOpen="{Binding HasScanSummary}" Severity="Informational" loc:Loc.Title="Folder scan"
                                 Message="{Binding ScanSummary}" IsClosable="False" />
                        <Expander loc:Loc.Header="Files ignored by this scan" IsExpanded="False"
                                  Visibility="{Binding HasScanSkipped, Converter={StaticResource BoolToVisibility}}"
                                  HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding Skipped}" MaxHeight="140">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource WarningBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="0">
                                                <TextBlock Text="{Binding FileName, Converter={StaticResource Localize}}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Reason, Converter={StaticResource Localize}}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Border Background="{ThemeResource DropZoneBackgroundBrush}" BorderBrush="{ThemeResource DropZoneBorderBrush}"
                                BorderThickness="1" CornerRadius="9"
                                Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                                <Border Background="{ThemeResource AccentSubtleBrush}" Width="62" Height="62" CornerRadius="16" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE714;" FontSize="28" Foreground="{ThemeResource AccentTextBrush}" />
                                </Border>
                                <TextBlock loc:Loc.Text="Drop videos here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock loc:Loc.Text="Add one or more videos, or scan a folder. Every processed video keeps its original audio."
                                           Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button loc:Loc.Content="Choose videos" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BrowseVideosCommand}" />
                                    <Button loc:Loc.Content="Scan a folder" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseFolderCommand}" />
                                </StackPanel>
                                <TextBlock loc:Loc.Text="Super-resolution runs frame by frame; frame interpolation uses RIFE between neighbouring frames."
                                           Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{Binding Files}" SelectionMode="None"
                                  Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="4,7" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="7" Background="{ThemeResource SubtleSurfaceBrush}" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="18"
                                                          Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayPath, Converter={StaticResource Localize}}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource FormatBadgeStyle}">
                                            <TextBlock Text="{Binding Dimensions, Converter={StaticResource Localize}}" FontSize="10" />
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveCommand}"
                                                loc:Loc.ToolTip="Remove from list" loc:Loc.AutomationName="Remove from list">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource InsetCardStyle}" Padding="12"
                            Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="7" Height="118">
                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock loc:Loc.Text="Preview" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="{Binding PreviewStatus, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <Button loc:Loc.Content="Open source video" Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding OpenInputCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Settings -->
            <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="0">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="18,16,18,10" Spacing="2">
                        <TextBlock loc:Loc.Text="Video enhancement" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock loc:Loc.Text="AI Super-resolution and frame interpolation are separate stages."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,4,18,18">
                        <StackPanel Spacing="15">
                            <StackPanel Spacing="8">
                                <ToggleSwitch loc:Loc.Header="AI super-resolution" IsOn="{Binding EnableSuperResolution, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="VideoUpscalerEnableSr" />
                                <StackPanel Spacing="4" Visibility="{Binding ShowImageSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Upscaling model" Style="{StaticResource CaptionTextStyle}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding ImageModels}" SelectedItem="{Binding SelectedImageModel, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  AutomationProperties.AutomationId="VideoUpscalerImageModel" />
                                        <Button Grid.Column="1" loc:Loc.Content="Manage" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ManageModelsCommand}" AutomationProperties.AutomationId="VideoUpscalerManageModels" />
                                    </Grid>
                                    <TextBlock Text="{Binding ImageModelStatus, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <StackPanel Spacing="4">
                                        <TextBlock loc:Loc.Text="Output scale" Style="{StaticResource CaptionTextStyle}" />
                                        <ComboBox ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <TextBlock loc:Loc.Text="Only the model's native scale is offered so the output is a genuine AI upscale." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding ShowTemporalSettings, Converter={StaticResource BoolToVisibility}}">
                                    <ToggleSwitch loc:Loc.Header="Temporal stability (reduce flicker)"
                                                  IsOn="{Binding EnableTemporalStability, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="VideoUpscalerEnableTemporal" />
                                    <StackPanel Spacing="4" Visibility="{Binding EnableTemporalStability, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <TextBlock loc:Loc.Text="Temporal strength" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding TemporalStabilityStrength, Converter={StaticResource Localize}}" HorizontalAlignment="Right"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                                Value="{Binding TemporalStabilityStrength, Mode=TwoWay}"
                                                AutomationProperties.AutomationId="VideoUpscalerTemporalStrength" />
                                        <TextBlock loc:Loc.Text="Motion-adaptive: static areas are blended, moving edges keep the current frame. Scene cuts reset the blend."
                                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerBrush}" />

                            <StackPanel Spacing="8">
                                <ToggleSwitch loc:Loc.Header="AI frame interpolation" IsOn="{Binding EnableInterpolation, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="VideoUpscalerEnableFi" />
                                <StackPanel Spacing="4" Visibility="{Binding ShowInterpolationSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Interpolation model" Style="{StaticResource CaptionTextStyle}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding InterpolationModels}" SelectedItem="{Binding SelectedInterpolationModel, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  AutomationProperties.AutomationId="VideoUpscalerInterpolationModel" />
                                        <Button Grid.Column="1" loc:Loc.Content="Manage" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ManageInterpolationModelsCommand}"
                                                AutomationProperties.AutomationId="VideoUpscalerManageInterpolationModels" />
                                    </Grid>
                                    <TextBlock Text="{Binding InterpolationModelStatus, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock loc:Loc.Text="Frame-rate multiplier" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch" />
                                    <TextBlock loc:Loc.Text="The output keeps the source duration and audio timing. Scene cuts are detected and are not interpolated across." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Text="Output preview" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding ExpectedOutput, Converter={StaticResource Localize}}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock loc:Loc.Text="MP4 · H.264 · original audio preserved where compatible" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Text="Video bitrate (kbps)" Style="{StaticResource CaptionTextStyle}" />
                                <NumberBox Minimum="100" Maximum="200000" SmallChange="500" SpinButtonPlacementMode="Compact"
                                           Value="{Binding VideoBitrateKbps, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Text="Execution provider" Style="{StaticResource CaptionTextStyle}" />
                                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding ProviderStatus, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Text="Destination" Style="{StaticResource CaptionTextStyle}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="6" Padding="9,6">
                                        <TextBlock Text="{Binding OutputDirectory, Converter={StaticResource Localize}}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding OutputDirectory, Converter={StaticResource Localize}}" />
                                    </Border>
                                    <Button Grid.Column="1" loc:Loc.Content="Choose" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ChooseOutputCommand}" AutomationProperties.AutomationId="VideoUpscalerChooseOutput" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenOutputCommand}"
                                            loc:Loc.ToolTip="Open destination" loc:Loc.AutomationName="Open destination">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="If a file exists" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding CollisionOptions}" SelectedItem="{Binding SelectedCollision, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock loc:Loc.Text="Filename suffix" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBox Text="{Binding FileNameSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             loc:Loc.Placeholder="e.g. _upscaled" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="8" Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibility}}">
                                <InfoBar IsOpen="True" Severity="Error" loc:Loc.Title="Cannot start" Message="{Binding ValidationSummary}" />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="{Binding HasValidationWarnings, Converter={StaticResource BoolToVisibility}}">
                                <InfoBar IsOpen="True" Severity="Warning" loc:Loc.Title="Review before processing" Message="{Binding ValidationSummary}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary, Converter={StaticResource Localize}}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding JobStatus, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button loc:Loc.Content="Compare last result" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CompareLastCommand}"
                            IsEnabled="{Binding CanCompare}" AutomationProperties.AutomationId="VideoUpscalerCompare" />
                    <Button loc:Loc.Content="Add to queue" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddToQueueCommand}"
                            IsEnabled="{Binding CanQueue}" AutomationProperties.AutomationId="VideoUpscalerAddToQueue" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
