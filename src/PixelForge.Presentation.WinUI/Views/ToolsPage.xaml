<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelForge.Presentation.Views.ToolsPage"
    x:Name="ToolsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PixelForge.Presentation.Controls"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    Background="Transparent">

    <Grid Padding="28,22,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="3">
                <TextBlock Text="Media Tools" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="ToolsTitle" />
                <TextBlock Text="Focused audio, image and video operations. Everything runs locally and joins the same processing queue."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <ProgressRing IsActive="{Binding IsLoading}" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <RadioButton GroupName="ToolCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsAudioCategory, Mode=OneWay}" Command="{Binding SelectAudioCategoryCommand}"
                                 AutomationProperties.AutomationId="ToolsCategoryAudio">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" />
                            <TextBlock Text="Audio" FontWeight="SemiBold" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ToolCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsImageCategory, Mode=OneWay}" Command="{Binding SelectImageCategoryCommand}"
                                 AutomationProperties.AutomationId="ToolsCategoryImage">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE91B;" FontSize="14" />
                            <TextBlock Text="Image" FontWeight="SemiBold" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="ToolCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsVideoCategory, Mode=OneWay}" Command="{Binding SelectVideoCategoryCommand}"
                                 AutomationProperties.AutomationId="ToolsCategoryVideo">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE714;" FontSize="14" />
                            <TextBlock Text="Video" FontWeight="SemiBold" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ToolOptions}" SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                              DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Tool" AutomationProperties.AutomationId="ToolsToolPicker" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:ResponsiveHeaderPanel ColumnSpacing="10" RowSpacing="6">
                        <Grid ColumnSpacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Input files" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource FormatBadgeStyle}">
                                <TextBlock Text="{Binding FileCountText}" FontSize="11" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Add files" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseCommand}"
                                    AutomationProperties.AutomationId="ToolsAddFiles" />
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ClearFilesCommand}"
                                    ToolTipService.ToolTip="Clear files" AutomationProperties.Name="Clear files">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </controls:ResponsiveHeaderPanel>

                    <Grid Grid.Row="1">
                        <Border Background="{ThemeResource DropZoneBackgroundBrush}" BorderBrush="{ThemeResource DropZoneBorderBrush}"
                                BorderThickness="1" CornerRadius="9"
                                Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
                                <Border Background="{ThemeResource AccentSubtleBrush}" Width="54" Height="54" CornerRadius="13" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="23" Foreground="{ThemeResource AccentTextBrush}" />
                                </Border>
                                <TextBlock Text="Drop files here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding InputHint}"
                                           Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
                                <Button Content="Choose files" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BrowseCommand}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{Binding Files}"
                                  Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="4,7" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="7" Background="{ThemeResource SubtleSurfaceBrush}" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="17"
                                                          Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{ThemeResource DangerBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveCommand}"
                                                ToolTipService.ToolTip="Remove from list" AutomationProperties.Name="Remove from list">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="8" Visibility="{Binding IsMergeTool, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="{ThemeResource DividerBrush}" />
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Merge order" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="The first input file plays first, followed by these files in order."
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Button Content="Add merge files" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"
                                    Command="{Binding BrowseMergeCommand}" AutomationProperties.AutomationId="ToolsAddMergeFiles" />
                        </Grid>
                        <ListView ItemsSource="{Binding MergeFiles}" MaxHeight="180" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Padding="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="OnMergeMoveUp"
                                                ToolTipService.ToolTip="Move up" AutomationProperties.Name="Move up">
                                            <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="OnMergeMoveDown"
                                                ToolTipService.ToolTip="Move down" AutomationProperties.Name="Move down">
                                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveCommand}"
                                                ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove merge input">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="18,16,18,10" Spacing="2">
                        <Grid>
                            <TextBlock Text="Tool settings" Style="{StaticResource SectionTitleTextStyle}" />
                            <ProgressRing IsActive="{Binding IsValidating}" Width="14" Height="14" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Only settings relevant to the selected tool are shown." Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,4,18,18">
                        <StackPanel Spacing="15">
                            <StackPanel Spacing="5" Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Preview" Style="{StaticResource CardTitleTextStyle}" />
                                <Border CornerRadius="8" Background="{ThemeResource SubtleSurfaceBrush}" Padding="6">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="220"
                                           HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Output format" Style="{StaticResource CaptionTextStyle}" />
                                <controls:FormatPicker ItemsSource="{Binding Formats}"
                                                       SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                                       AutomationId="ToolsFormatPicker" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Destination" Style="{StaticResource CaptionTextStyle}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="6" Padding="9,6">
                                        <TextBlock Text="{Binding OutputDirectory}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding OutputDirectory}" />
                                    </Border>
                                    <Button Grid.Column="1" Content="Choose" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChooseOutputCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenOutputCommand}"
                                            ToolTipService.ToolTip="Open destination folder" AutomationProperties.Name="Open destination folder">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="If a file exists" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding CollisionOptions}" SelectedItem="{Binding SelectedCollision, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Filename suffix" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBox Text="{Binding FileNameSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="optional" />
                                </StackPanel>
                            </Grid>

                            <!-- Audio tools -->
                            <StackPanel Spacing="14" Visibility="{Binding IsAudioCategory, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <StackPanel Spacing="5" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Waveform" Style="{StaticResource CardTitleTextStyle}" />
                                    <controls:WaveformView
                                        Source="{Binding WaveformImage}"
                                        DurationSeconds="{Binding WaveformDuration}"
                                        StartSeconds="{Binding TrimStartSeconds}"
                                        EndSeconds="{Binding TrimEndSeconds}"
                                        ShowMarkers="{Binding ShowWaveformMarkers}"
                                        IsLoading="{Binding IsWaveformLoading}"
                                        Visibility="{Binding ShowWaveform, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding WaveformStatus}" Style="{StaticResource CaptionTextStyle}"
                                               Visibility="{Binding ShowWaveform, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                                <Grid ColumnSpacing="8" Visibility="{Binding ShowAudioChannelsRate, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Sample rate" Style="{StaticResource CaptionTextStyle}" />
                                        <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SelectedSampleRate, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Channels" Style="{StaticResource CaptionTextStyle}" />
                                        <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannels, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4" Visibility="{Binding ShowAudioBitrate, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Bitrate" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding SelectedAudioBitrate, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsAudioNormalize, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Loudness target" Style="{StaticResource CardTitleTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Integrated (LUFS)" Minimum="-40" Maximum="-5" SmallChange="0.5"
                                                   Value="{Binding TargetLufs, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="True peak (dBTP)" Minimum="-9" Maximum="0" SmallChange="0.1"
                                                   Value="{Binding TruePeakDb, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <NumberBox Header="Loudness range (LU)" Minimum="1" Maximum="30" SmallChange="1"
                                               Value="{Binding LoudnessRange, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="Two-pass EBU R128 measurement. Peak protection is applied to avoid clipping."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsAudioNoise, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Noise reduction" Style="{StaticResource CardTitleTextStyle}" />
                                    <ComboBox ItemsSource="{Binding NoiseMethods}" SelectedItem="{Binding SelectedNoiseMethod, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Reduction strength" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding NoiseReductionDb}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                        <Slider Minimum="1" Maximum="36" StepFrequency="1" Value="{Binding NoiseReductionDb, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="RNNoise is designed for speech. Spectral denoise is more general but can soften quiet detail."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsAudioSilence, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Silence detection" Style="{StaticResource CardTitleTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Threshold (dB)" Minimum="-80" Maximum="-10" SmallChange="1"
                                                   Value="{Binding SilenceThresholdDb, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Minimum silence (s)" Minimum="0.1" Maximum="30" SmallChange="0.1"
                                                   Value="{Binding MinSilenceSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <NumberBox Header="Keep margin around speech (s)" Minimum="0" Maximum="2" SmallChange="0.05"
                                               Value="{Binding KeepSilenceMarginSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="Silent regions are detected on the source and removed with a short margin so breaths and soft speech are preserved."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsAudioTrim, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Trim range" Style="{StaticResource CardTitleTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Start (s)" Minimum="0" SmallChange="0.1" Value="{Binding TrimStartSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="End (s, 0 = source end)" Minimum="0" SmallChange="0.1" Value="{Binding TrimEndSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsAudioMerge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Merge audio" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="The first input is followed by the merge list. Inputs are resampled to a common rate and channel layout; the order is shown on the left."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsAudioMetadata, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Audio metadata" Style="{StaticResource CardTitleTextStyle}" />
                                    <ComboBox ItemsSource="{Binding MetadataModes}" SelectedItem="{Binding SelectedMetadataMode, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    <TextBox Header="Title" Text="{Binding MetaTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Artist" Text="{Binding MetaArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Album" Text="{Binding MetaAlbum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Album artist" Text="{Binding MetaAlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBox Header="Genre" Text="{Binding MetaGenre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Header="Year / date" Text="{Binding MetaYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBox Header="Track" Text="{Binding MetaTrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Header="Disc" Text="{Binding MetaDisc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <TextBox Header="Composer" Text="{Binding MetaComposer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Comment" Text="{Binding MetaComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Header="Cover art" Text="{Binding CoverArtPath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="No cover selected" />
                                        <Button Grid.Column="1" Content="Choose" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"
                                                Command="{Binding BrowseCoverArtCommand}" />
                                    </Grid>
                                    <ToggleSwitch Header="Remove embedded cover art" IsOn="{Binding RemoveCoverArt, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsAudioExtract, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Audio track" Style="{StaticResource CardTitleTextStyle}" />
                                    <NumberBox Header="Audio stream index (0 = first)" Minimum="0" Maximum="64" SmallChange="1"
                                               Value="{Binding AudioStreamIndex, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <ToggleSwitch Header="Copy the original audio stream when compatible" IsOn="{Binding CopyAudioStream, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Image tools -->
                            <StackPanel Spacing="14" Visibility="{Binding IsImageCategory, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <StackPanel Spacing="10" Visibility="{Binding ShowImageOptimizeSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Compression" Style="{StaticResource CardTitleTextStyle}" />
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <TextBlock Text="Quality" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding Quality}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                        <Slider Minimum="1" Maximum="100" StepFrequency="1" Value="{Binding Quality, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="PNG compression" Minimum="0" Maximum="9" SmallChange="1" Value="{Binding PngCompression, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="AVIF speed" Minimum="0" Maximum="10" SmallChange="1" Value="{Binding AvifSpeed, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <ToggleSwitch Header="Lossless WebP" IsOn="{Binding Lossless, Mode=TwoWay}" />
                                    <ToggleSwitch Header="Preserve transparency" IsOn="{Binding PreserveAlpha, Mode=TwoWay}" />
                                    <TextBox Header="Flatten background colour" Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="transparent or #FFFFFF" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowImageBatchEditSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Batch edit pipeline" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="Fixed order: crop → resize → denoise → sharpen → colour → watermark → metadata → encode."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Denoise strength" Style="{StaticResource CaptionTextStyle}" />
                                            <Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding DenoiseStrength, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Sharpen amount" Style="{StaticResource CaptionTextStyle}" />
                                            <Slider Minimum="0" Maximum="200" StepFrequency="1" Value="{Binding SharpenAmount, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Text="Brightness" Style="{StaticResource CaptionTextStyle}" /><Slider Minimum="0" Maximum="200" StepFrequency="1" Value="{Binding Brightness, Mode=TwoWay}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Contrast" Style="{StaticResource CaptionTextStyle}" /><Slider Minimum="0" Maximum="200" StepFrequency="1" Value="{Binding Contrast, Mode=TwoWay}" /></StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Saturation" Style="{StaticResource CaptionTextStyle}" /><Slider Minimum="0" Maximum="200" StepFrequency="1" Value="{Binding Saturation, Mode=TwoWay}" /></StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Exposure (EV)" Minimum="-5" Maximum="5" SmallChange="0.1" Value="{Binding Exposure, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Gamma" Minimum="0.1" Maximum="5" SmallChange="0.1" Value="{Binding Gamma, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <TextBlock Text="Crop and resize" Style="{StaticResource CardTitleTextStyle}" Margin="0,4,0,0" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Crop X" Minimum="0" SmallChange="1" Value="{Binding CropX, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Crop Y" Minimum="0" SmallChange="1" Value="{Binding CropY, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Crop width" Minimum="0" SmallChange="1" Value="{Binding CropWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Crop height" Minimum="0" SmallChange="1" Value="{Binding CropHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <ComboBox Header="Crop aspect ratio" ItemsSource="{Binding CropAspectRatios}" SelectedItem="{Binding CropAspectRatio, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Resize width" Minimum="1" SmallChange="1" Value="{Binding ResizeWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Resize height" Minimum="1" SmallChange="1" Value="{Binding ResizeHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <ToggleSwitch Header="Preserve aspect ratio when resizing" IsOn="{Binding PreserveAspectRatio, Mode=TwoWay}" />
                                    <TextBlock Text="Watermark" Style="{StaticResource CardTitleTextStyle}" Margin="0,4,0,0" />
                                    <ComboBox ItemsSource="{Binding WatermarkKinds}" SelectedItem="{Binding SelectedWatermarkKind, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    <TextBox Header="Watermark text" Text="{Binding WatermarkText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Header="Watermark image" Text="{Binding WatermarkImagePath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="No image selected" />
                                        <Button Grid.Column="1" Content="Choose" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"
                                                Command="{Binding BrowseWatermarkImageCommand}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ComboBox Header="Position" ItemsSource="{Binding WatermarkPositions}" SelectedItem="{Binding WatermarkPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <NumberBox Grid.Column="1" Header="Margin (px)" Minimum="0" Maximum="500" Value="{Binding WatermarkMargin, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Text="Opacity" Style="{StaticResource CaptionTextStyle}" /><Slider Minimum="0.05" Maximum="1" StepFrequency="0.05" Value="{Binding WatermarkOpacity, Mode=TwoWay}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Scale" Style="{StaticResource CaptionTextStyle}" /><Slider Minimum="0.02" Maximum="0.9" StepFrequency="0.01" Value="{Binding WatermarkScale, Mode=TwoWay}" /></StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsBackgroundRemoval, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Background removal" Style="{StaticResource CardTitleTextStyle}" />
                                    <ComboBox ItemsSource="{Binding ExecutionProviders}" SelectedItem="{Binding SelectedExecutionProvider, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    <TextBox Header="Background colour" Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="transparent or #FFFFFF" />
                                    <TextBlock Text="Uses the bundled u2netp salient-object model. Transparent output requires PNG, WebP, AVIF or another alpha-capable format. CPU fallback is automatic."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsImageMetadata, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Image metadata" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBox Header="Description" Text="{Binding ImageMetaDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Copyright" Text="{Binding ImageMetaCopyright, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Artist / creator" Text="{Binding ImageMetaArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Comment" Text="{Binding ImageMetaComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ToggleSwitch Header="Remove all metadata" IsOn="{Binding RemoveAllImageMetadata, Mode=TwoWay}" />
                                </StackPanel>

                                <ToggleSwitch Header="Preserve metadata when the format allows" IsOn="{Binding PreserveMetadata, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Video tools -->
                            <StackPanel Spacing="14" Visibility="{Binding IsVideoCategory, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <StackPanel Spacing="4" Visibility="{Binding ShowVideoContainerSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Video codec" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding VideoCodecOptions}" SelectedValue="{Binding VideoCodecId, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Audio codec" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                                    <ComboBox ItemsSource="{Binding VideoAudioCodecOptions}" SelectedValue="{Binding AudioCodecId, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowVideoCompressSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Compression" Style="{StaticResource CardTitleTextStyle}" />
                                    <ComboBox ItemsSource="{Binding CompressionPresets}" SelectedItem="{Binding SelectedCompressionPreset, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    <NumberBox Header="Target size (MB)" Minimum="1" Maximum="20000" SmallChange="1"
                                               Value="{Binding TargetSizeMb, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="{Binding CompressionEstimate}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <NumberBox Header="Audio bitrate (kbps)" Minimum="32" Maximum="512" SmallChange="16"
                                               Value="{Binding VideoAudioBitrateKbps, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="Two-pass encoding is used for software encoders that support it. If the exact target cannot be reached, the job reports the actual size instead of claiming success."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowVideoTrimSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Trim range" Style="{StaticResource CardTitleTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Start (s)" Minimum="0" SmallChange="0.1" Value="{Binding TrimStartSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="End (s, 0 = source end)" Minimum="0" SmallChange="0.1" Value="{Binding TrimEndSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <ToggleSwitch Header="Frame-accurate trim (re-encode)" IsOn="{Binding FrameAccurateTrim, Mode=TwoWay}" />
                                    <TextBlock Text="Disable frame-accurate trim to stream-copy at the nearest keyframe. The job reports when keyframe alignment shifts the cut."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding IsVideoMerge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Merge video" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="Stream copy is used only when container, codecs, resolution, frame rate and audio layout match. Otherwise each input is scaled to a common resolution and re-encoded. Subtitle streams are not preserved in the re-encoded path."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowVideoStabilizeSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Stabilisation" Style="{StaticResource CardTitleTextStyle}" />
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Strength" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding StabilizationStrength}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                        <Slider Minimum="0.1" Maximum="1" StepFrequency="0.05" Value="{Binding StabilizationStrength, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="FFmpeg deshake analyses the whole clip and re-encodes it. Processing time can be several times the source duration."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowThumbnailSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Thumbnail" Style="{StaticResource CardTitleTextStyle}" />
                                    <NumberBox Header="Timestamp (s)" Minimum="0" SmallChange="0.5" Value="{Binding ThumbnailTimeSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="A representative frame is selected around the timestamp to avoid black frames. Choose JPG, PNG or WebP above."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowGifSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="GIF range" Style="{StaticResource CardTitleTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Start (s)" Minimum="0" SmallChange="0.1" Value="{Binding GifStartSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="End (s)" Minimum="0.1" SmallChange="0.1" Value="{Binding GifEndSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Frame rate" Minimum="1" Maximum="30" SmallChange="1" Value="{Binding GifFps, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Width (px)" Minimum="16" Maximum="1920" SmallChange="16" Value="{Binding GifWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <TextBlock Text="GIF is not equivalent to a modern compressed video and can be much larger."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowVideoExtractSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Audio extraction" Style="{StaticResource CardTitleTextStyle}" />
                                    <NumberBox Header="Audio stream index (0 = first)" Minimum="0" Maximum="64" SmallChange="1"
                                               Value="{Binding AudioStreamIndex, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <ToggleSwitch Header="Copy the original audio stream when compatible" IsOn="{Binding CopyAudioStream, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowVideoReplaceSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Replace audio" Style="{StaticResource CardTitleTextStyle}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Header="Replacement audio" Text="{Binding ReplacementAudioPath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="No audio selected" />
                                        <Button Grid.Column="1" Content="Choose" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"
                                                Command="{Binding BrowseReplacementAudioCommand}" />
                                    </Grid>
                                    <NumberBox Header="Audio offset (s)" Minimum="-30" Maximum="30" SmallChange="0.05"
                                               Value="{Binding AudioOffsetSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="Video is copied without re-encoding when the container supports the source codec. Check synchronisation after processing."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowSubtitleSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Subtitles" Style="{StaticResource CardTitleTextStyle}" />
                                    <ComboBox ItemsSource="{Binding SubtitleModes}" SelectedItem="{Binding SelectedSubtitleMode, Mode=TwoWay}"
                                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                                    <NumberBox Header="Subtitle stream index (0 = first)" Minimum="0" Maximum="64" SmallChange="1"
                                               Value="{Binding SubtitleStreamIndex, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="Text subtitle tracks can be extracted to SRT, VTT or ASS. Image-based subtitles are refused rather than silently converted without OCR."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowVideoMetadataSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Video metadata" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBox Header="Title" Text="{Binding VideoMetaTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Artist" Text="{Binding VideoMetaArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Comment" Text="{Binding VideoMetaComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Year / date" Text="{Binding VideoMetaYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ToggleSwitch Header="Remove all metadata" IsOn="{Binding RemoveAllVideoMetadata, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowHdrSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="HDR to SDR" Style="{StaticResource CardTitleTextStyle}" />
                                    <NumberBox Header="Tone-map peak (nits)" Minimum="50" Maximum="1000" SmallChange="10"
                                               Value="{Binding ToneMapPeakNits, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Text="Uses zscale, linear-light processing and hable tone mapping, then writes BT.709 SDR video. Metadata flags alone are not changed."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="10" Visibility="{Binding ShowVideoResizeSettings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Resolution and frame rate" Style="{StaticResource CardTitleTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Width" Minimum="2" Maximum="16384" SmallChange="2" Value="{Binding ResizeWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                        <NumberBox Grid.Column="1" Header="Height" Minimum="2" Maximum="16384" SmallChange="2" Value="{Binding ResizeHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                    <NumberBox Header="Frame rate (0 = source)" Minimum="0" Maximum="240" SmallChange="1"
                                               Value="{Binding VideoFrameRate, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                    <ToggleSwitch Header="Preserve aspect ratio" IsOn="{Binding PreserveAspectRatio, Mode=TwoWay}" />
                                    <TextBlock Text="This is ordinary Lanczos scaling, not AI upscaling. The Image Upscaler remains the dedicated AI path."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Header="Preserve metadata when supported" IsOn="{Binding PreserveMetadata, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Validation -->
                            <StackPanel Spacing="8" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                                <InfoBar IsOpen="{Binding HasValidationErrors}" Severity="Error"
                                         Title="Operation needs attention" Message="{Binding ValidationSummary}" />
                                <InfoBar IsOpen="{Binding HasValidationWarnings}" Severity="Warning"
                                         Title="Review warnings" Message="{Binding ValidationSummary}" />
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="7" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding OutputDirectory}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Open output" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenOutputCommand}" />
                    <Button Content="Add to queue" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddToQueueCommand}"
                            IsEnabled="{Binding CanAddToQueue}" AutomationProperties.AutomationId="ToolsAddToQueue" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
