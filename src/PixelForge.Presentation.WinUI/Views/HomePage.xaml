<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelForge.Presentation.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Home" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="HomeTitle" />
                    <TextBlock Text="A local studio for image, audio and video conversion — plus AI upscaling."
                               Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="{ThemeResource AccentSubtleBrush}"
                        BorderBrush="{ThemeResource AccentSubtleBorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hero -->
            <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0" CornerRadius="14">
                <Grid MinHeight="280">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Padding="30,26,26,26" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="PIXELFORGE STUDIO" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="130" Foreground="{ThemeResource AccentTextBrush}" />
                        <TextBlock Text="Make media work for you." FontSize="30" FontWeight="SemiBold" LineHeight="36" />
                        <TextBlock Text="Convert images, transcode audio and video, or reconstruct detail with AI — all on this PC. Your files never leave the machine."
                                   Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="620" HorizontalAlignment="Left" />
                        <Border x:Name="HeroDropZone" Background="{ThemeResource DropZoneBackgroundBrush}"
                                BorderBrush="{ThemeResource DropZoneBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18,14" Margin="0,4,0,0">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource AccentSubtleBrush}" Width="38" Height="38" CornerRadius="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE898;" FontSize="18" Foreground="{ThemeResource AccentTextBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Drop images, audio, video, or a folder" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Files are routed to the right workspace automatically." Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseCommand}" AutomationProperties.AutomationId="HomeBrowseButton" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" MinHeight="280">
                        <Ellipse Width="320" Height="320" Fill="{ThemeResource AccentGlowBrush}" Opacity="0.55"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="210" Height="210" Fill="{ThemeResource SubtleSurfaceBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="ms-appx:///Assets/Logo.png" Width="132" Height="132"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,26">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock Text="100% local · no account" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick actions -->
            <StackPanel Grid.Row="2" Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start something" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusDetail}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CardButtonStyle}" Padding="16,14"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenImageConverterCommand}" AutomationProperties.AutomationId="HomeImageConvert">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource AccentSubtleBrush}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE91B;" FontSize="20" Foreground="{ThemeResource AccentTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Convert images" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="PNG, JPEG, WebP, AVIF, TIFF, GIF, ICO, JPEG XL" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CardButtonStyle}" Padding="16,14"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenAudioConverterCommand}" AutomationProperties.AutomationId="HomeAudioConvert">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D6;" FontSize="20" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Convert audio" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="MP3, WAV, FLAC, AAC, M4A, OGG, Opus" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CardButtonStyle}" Padding="16,14"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenVideoConverterCommand}" AutomationProperties.AutomationId="HomeVideoConvert">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE714;" FontSize="20" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Transcode video" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="Remux or transcode H.264, HEVC, AV1, VP9 and more" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CardButtonStyle}" Padding="16,14"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenUpscalerCommand}" AutomationProperties.AutomationId="HomeUpscaler">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource AccentSubtleBrush}" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE71E;" FontSize="20" Foreground="{ThemeResource AccentTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Upscale images" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Text="Traditional resampling, Real-ESRGAN, Waifu2x and restoration" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Active jobs + Engine status -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Active processing" Style="{StaticResource SectionTitleTextStyle}" />
                            <Button HorizontalAlignment="Right" Content="Open queue" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding OpenQueueCommand}" AutomationProperties.AutomationId="HomeOpenQueue" />
                        </Grid>
                        <StackPanel x:Name="ActiveEmptyState" Spacing="8" Padding="0,8,0,10"
                                    Visibility="{Binding HasActiveJobs, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Nothing in the queue" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a workspace above, add files, and PixelForge will keep working while you browse."
                                       Style="{StaticResource SecondaryTextStyle}" MaxWidth="480" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ActiveJobs}" Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,8" Margin="0,0,0,6"
                                            HorizontalContentAlignment="Stretch" Command="{Binding OpenQueueCommand}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="3" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding StateText}" FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource AccentTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Engine status" Style="{StaticResource SectionTitleTextStyle}" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}" ToolTipService.ToolTip="Open diagnostics"
                                    AutomationProperties.AutomationId="HomeEngineSettings">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="32" Height="32" CornerRadius="7" VerticalAlignment="Top">
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="15" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Grid Width="8" Height="8">
                                                <Ellipse Fill="{ThemeResource SuccessBrush}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse Fill="{ThemeResource DangerBrush}" Visibility="{Binding IsReady, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent -->
            <Border Grid.Row="4" Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Recent activity" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button HorizontalAlignment="Right" Content="View history" Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding OpenHistoryCommand}" AutomationProperties.AutomationId="HomeOpenHistory" />
                    </Grid>
                    <StackPanel Spacing="6" Padding="0,8,0,12"
                                Visibility="{Binding HasRecentFiles, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Your processed files will show up here." FontWeight="SemiBold" />
                        <TextBlock Text="PixelForge keeps a searchable history without storing copies of your media."
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Recent}" Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="4,9" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="34" Height="34" CornerRadius="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="15" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinWidth="56" TextAlignment="Right" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SuccessBrush}"
                                                  Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}" />
                                        <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource DangerBrush}"
                                                  Visibility="{Binding IsSuccess, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenCommand}" ToolTipService.ToolTip="Open file"
                                                AutomationProperties.AutomationId="RecentOpen">
                                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RevealCommand}" ToolTipService.ToolTip="Show in folder">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CompareCommand}"
                                                Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}"
                                                ToolTipService.ToolTip="Compare before and after">
                                            <FontIcon Glyph="&#xE8AB;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
