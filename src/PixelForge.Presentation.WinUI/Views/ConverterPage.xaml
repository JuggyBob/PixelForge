<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelForge.Presentation.Views.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PixelForge.Presentation.Localization"
    xmlns:controls="using:PixelForge.Presentation.Controls"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    Background="Transparent">

    <Grid Padding="28,22,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock loc:Loc.Text="Converter" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="ConverterTitle" />
                <TextBlock loc:Loc.Text="One workspace for images, audio, video, documents, e-books and archives. Import, configure, queue."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center"
                             Visibility="{Binding IsEngineReady, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressRing IsActive="{Binding IsLoading}" Width="12" Height="12"
                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding EngineStatus, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Category selector -->
        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="ConverterCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     IsChecked="{Binding IsImagesSelected, Mode=OneWay}" Checked="OnCategoryChecked" Tag="Image"
                                     AutomationProperties.AutomationId="CategoryImages">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE91B;" FontSize="14" />
                                <TextBlock loc:Loc.Text="Images" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" GroupName="ConverterCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     IsChecked="{Binding IsAudioSelected, Mode=OneWay}" Checked="OnCategoryChecked" Tag="Audio"
                                     AutomationProperties.AutomationId="CategoryAudio">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" />
                                <TextBlock loc:Loc.Text="Audio" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" GroupName="ConverterCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     IsChecked="{Binding IsVideoSelected, Mode=OneWay}" Checked="OnCategoryChecked" Tag="Video"
                                     AutomationProperties.AutomationId="CategoryVideo">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE714;" FontSize="14" />
                                <TextBlock loc:Loc.Text="Video" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="3" GroupName="ConverterCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     IsChecked="{Binding IsDocumentsSelected, Mode=OneWay}" Checked="OnCategoryChecked" Tag="Document"
                                     AutomationProperties.AutomationId="CategoryDocuments">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock loc:Loc.Text="Documents" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="4" GroupName="ConverterCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     IsChecked="{Binding IsEbooksSelected, Mode=OneWay}" Checked="OnCategoryChecked" Tag="Ebook"
                                     AutomationProperties.AutomationId="CategoryEbooks">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE736;" FontSize="14" />
                                <TextBlock loc:Loc.Text="E-books" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="5" GroupName="ConverterCategory" Style="{StaticResource SegmentRadioButtonStyle}"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     IsChecked="{Binding IsArchivesSelected, Mode=OneWay}" Checked="OnCategoryChecked" Tag="Archive"
                                     AutomationProperties.AutomationId="CategoryArchives">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock loc:Loc.Text="Archives" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="16" Margin="2,2,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CategorySummary, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionHint, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <Button loc:Loc.Content="Clear all" Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding ClearAllFilesCommand}"
                                    Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.AutomationId="ConverterClearAll" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Input files -->
            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:ResponsiveHeaderPanel ColumnSpacing="10" RowSpacing="6">
                        <Grid ColumnSpacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock loc:Loc.Text="Input files" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource FormatBadgeStyle}">
                                <TextBlock Text="{Binding CurrentWorkspace.FileCountText, Converter={StaticResource Localize}}" FontSize="11" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button loc:Loc.Content="Scan folder" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ScanFolderCommand}"
                                    AutomationProperties.AutomationId="ConverterScanFolder" />
                            <Button loc:Loc.Content="Add files" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseCommand}" AutomationProperties.AutomationId="ConverterAddFiles" />
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ClearFilesCommand}"
                                    loc:Loc.ToolTip="Clear this category" loc:Loc.AutomationName="Clear this category" AutomationProperties.AutomationId="ConverterClearFiles">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </controls:ResponsiveHeaderPanel>

                    <CheckBox Grid.Row="1" loc:Loc.Content="Include subfolders" FontSize="12" MinHeight="0"
                              VerticalAlignment="Center" Margin="0,0,0,2"
                              IsChecked="{Binding ScanSubfolders, Mode=TwoWay}"
                              loc:Loc.AutomationName="Include subfolders in folder scans" />

                    <StackPanel Grid.Row="2" Spacing="6">
                        <InfoBar IsOpen="{Binding HasScanSummary}" Severity="Informational" loc:Loc.Title="Folder scan"
                                 Message="{Binding ScanSummary}" IsClosable="False" />
                        <Expander loc:Loc.Header="Files ignored by this scan" IsExpanded="False"
                                  Visibility="{Binding HasScanSkipped, Converter={StaticResource BoolToVisibility}}"
                                  HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding ScanSkipped}" MaxHeight="150">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource WarningBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="0">
                                                <TextBlock Text="{Binding FileName, Converter={StaticResource Localize}}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Reason, Converter={StaticResource Localize}}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <!-- Empty state / drop target -->
                        <Border Background="{ThemeResource DropZoneBackgroundBrush}" BorderBrush="{ThemeResource DropZoneBorderBrush}"
                                BorderThickness="1" CornerRadius="9"
                                Visibility="{Binding CurrentWorkspace.HasFiles, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
                                <Border Background="{ThemeResource AccentSubtleBrush}" Width="58" Height="58" CornerRadius="14" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE898;" FontSize="25" Foreground="{ThemeResource AccentTextBrush}" />
                                </Border>
                                <TextBlock loc:Loc.Text="Drop files here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock loc:Loc.Text="Images, audio, video, documents, e-books and archives are routed into their matching category. You can also mix types in one drop."
                                           Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
                                <Button loc:Loc.Content="Choose files" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BrowseCommand}"
                                        HorizontalAlignment="Center" AutomationProperties.AutomationId="ConverterChooseFiles" />
                                <TextBlock loc:Loc.Text="Drag and drop from Explorer · local only" Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListView x:Name="FileList" ItemsSource="{Binding CurrentWorkspace.Files}"
                                  Visibility="{Binding CurrentWorkspace.HasFiles, Converter={StaticResource BoolToVisibility}}"
                                  SelectionMode="None" IsItemClickEnabled="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="4,7" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="7" Background="{ThemeResource SubtleSurfaceBrush}" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="18"
                                                          Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName, Converter={StaticResource Localize}}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ErrorText, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource DangerBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource FormatBadgeStyle}"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding BadgeText, Converter={StaticResource Localize}}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveCommand}"
                                                loc:Loc.ToolTip="Remove from list" loc:Loc.AutomationName="Remove from list">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Settings -->
            <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="0">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="18,16,18,10" Spacing="2">
                        <Grid>
                            <TextBlock loc:Loc.Text="Output settings" Style="{StaticResource SectionTitleTextStyle}" />
                            <ProgressRing IsActive="{Binding CurrentWorkspace.IsValidating}" Width="14" Height="14" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock loc:Loc.Text="Only settings valid for the selected format are shown."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,4,18,18">
                        <StackPanel Spacing="15">
                            <StackPanel Spacing="6">
                                <TextBlock loc:Loc.Text="Format" Style="{StaticResource CaptionTextStyle}" />
                                <controls:FormatPicker ItemsSource="{Binding CurrentWorkspace.Formats}"
                                                       SelectedItem="{Binding CurrentWorkspace.SelectedFormat, Mode=TwoWay}"
                                                       AutomationId="ConverterFormatPicker" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Text="Destination" Style="{StaticResource CaptionTextStyle}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="6" Padding="9,6">
                                        <TextBlock Text="{Binding CurrentWorkspace.OutputDirectory, Converter={StaticResource Localize}}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding CurrentWorkspace.OutputDirectory, Converter={StaticResource Localize}}" />
                                    </Border>
                                    <Button Grid.Column="1" loc:Loc.Content="Choose" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ChooseOutputCommand}" AutomationProperties.AutomationId="ConverterChooseOutput" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenOutputCommand}"
                                            loc:Loc.ToolTip="Open destination folder" loc:Loc.AutomationName="Open destination folder">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding CurrentWorkspace.EffectiveOutputDirectory, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding CurrentWorkspace.EffectiveOutputDirectory, Converter={StaticResource Localize}}" />
                            </StackPanel>

                            <Expander loc:Loc.Header="Per-format destinations" IsExpanded="False" HorizontalAlignment="Stretch"
                                      loc:Loc.AutomationName="Per-format output destinations">
                                <StackPanel Spacing="6" Padding="2,4">
                                    <TextBlock loc:Loc.Text="Give a format its own folder. Leave a row empty to use the general destination above."
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding CurrentWorkspace.FormatOutputOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="6" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label, Converter={StaticResource Localize}}" FontSize="11" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label, Converter={StaticResource Localize}}" />
                                                    <TextBox Grid.Column="1" Text="{Binding Directory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             loc:Loc.Placeholder="Use general destination" FontSize="11" />
                                                    <Button Grid.Column="2" loc:Loc.Content="Choose" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding ChooseCommand}" loc:Loc.AutomationName="Choose folder for format" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="If a file exists" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding CurrentWorkspace.CollisionOptions}"
                                              SelectedItem="{Binding CurrentWorkspace.SelectedCollision, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch"
                                              loc:Loc.AutomationName="Output collision policy" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock loc:Loc.Text="Filename suffix" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBox Text="{Binding CurrentWorkspace.FileNameSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             loc:Loc.Placeholder="optional, e.g. _converted" loc:Loc.AutomationName="Filename suffix" />
                                </StackPanel>
                            </Grid>

                            <!-- Image settings -->
                            <StackPanel Spacing="14" Visibility="{Binding IsImagesSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <StackPanel Spacing="6" Visibility="{Binding Image.ShowQuality, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock loc:Loc.Text="Quality" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Image.Quality, Converter={StaticResource Localize}}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="100" StepFrequency="1" Value="{Binding Image.Quality, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{Binding Image.ShowPngCompression, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock loc:Loc.Text="PNG compression level" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Image.PngCompression, Converter={StaticResource Localize}}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="9" StepFrequency="1" Value="{Binding Image.PngCompression, Mode=TwoWay}" />
                                </StackPanel>
                                <ToggleSwitch loc:Loc.Header="Lossless WebP" IsOn="{Binding Image.LosslessWebP, Mode=TwoWay}"
                                              Visibility="{Binding Image.ShowLossless, Converter={StaticResource BoolToVisibility}}" />
                                <ToggleSwitch loc:Loc.Header="Progressive JPEG" IsOn="{Binding Image.ProgressiveJpeg, Mode=TwoWay}"
                                              Visibility="{Binding Image.ShowProgressive, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Spacing="6" Visibility="{Binding Image.ShowAvifSpeed, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock loc:Loc.Text="AVIF encoder speed" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Image.AvifSpeed, Converter={StaticResource Localize}}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" StepFrequency="1" Value="{Binding Image.AvifSpeed, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{Binding Image.ShowGifColors, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock loc:Loc.Text="GIF colours" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Image.GifColors, Converter={StaticResource Localize}}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="2" Maximum="256" StepFrequency="2" Value="{Binding Image.GifColors, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Image.ShowTiffCompression, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="TIFF compression" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Image.TiffCompressionOptions}" SelectedItem="{Binding Image.TiffCompression, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Image.ShowIcoSizes, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Icon sizes" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBox Text="{Binding Image.IcoSizes, Mode=TwoWay}" PlaceholderText="256,128,64,48,32,16" />
                                </StackPanel>

                                <ToggleSwitch loc:Loc.Header="Resize output" IsOn="{Binding Image.EnableResize, Mode=TwoWay}" />
                                <Grid ColumnSpacing="8" Visibility="{Binding Image.EnableResize, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox loc:Loc.Header="Width" Minimum="1" Maximum="32768" SpinButtonPlacementMode="Compact"
                                               Value="{Binding Image.ResizeWidth, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" loc:Loc.Header="Height" Minimum="1" Maximum="32768" SpinButtonPlacementMode="Compact"
                                               Value="{Binding Image.ResizeHeight, Mode=TwoWay}" />
                                </Grid>
                                <ToggleSwitch loc:Loc.Header="Preserve aspect ratio" IsOn="{Binding Image.PreserveAspect, Mode=TwoWay}"
                                              Visibility="{Binding Image.EnableResize, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Spacing="4" Visibility="{Binding Image.EnableResize, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Resize mode" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Image.ResizeModes}" SelectedItem="{Binding Image.ResizeMode, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="Resampling" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Image.ResamplingOptions}" SelectedItem="{Binding Image.Resampling, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Image.ShowTransparency, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Transparency" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Image.TransparencyOptions}" SelectedItem="{Binding Image.Transparency, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Image.ShowBackgroundColor, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Background colour (hex)" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBox Text="{Binding Image.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" loc:Loc.Placeholder="#FFFFFF" />
                                </StackPanel>
                                <StackPanel Spacing="8" Visibility="{Binding Image.ShowAnimationControls, Converter={StaticResource BoolToVisibility}}">
                                    <ToggleSwitch loc:Loc.Header="Preserve animation / pages" IsOn="{Binding Image.PreserveAnimation, Mode=TwoWay}"
                                                  Visibility="{Binding Image.ShowPreserveAnimation, Converter={StaticResource BoolToVisibility}}" />
                                    <ToggleSwitch loc:Loc.Header="Flatten to one frame" IsOn="{Binding Image.FlattenAnimation, Mode=TwoWay}" />
                                </StackPanel>
                                <ToggleSwitch loc:Loc.Header="Preserve ICC colour profile" IsOn="{Binding Image.PreserveIccProfile, Mode=TwoWay}"
                                              Visibility="{Binding Image.ShowIcc, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- Audio settings -->
                            <StackPanel Spacing="14" Visibility="{Binding IsAudioSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="Audio codec" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Audio.Codecs}" SelectedItem="{Binding Audio.SelectedCodec, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="Encoder" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Audio.Encoders}" SelectedItem="{Binding Audio.SelectedEncoder, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" />
                                    <TextBlock Text="{Binding Audio.EncoderHint, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Audio.ShowRateControl, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Rate control" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Audio.RateControlOptions}" SelectedItem="{Binding Audio.SelectedRateControl, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Audio.ShowBitrate, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Bitrate" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Audio.BitrateOptions}" SelectedItem="{Binding Audio.SelectedBitrate, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{Binding Audio.ShowVariableQuality, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock loc:Loc.Text="Variable quality" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Audio.VariableQuality, Converter={StaticResource Localize}}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" StepFrequency="1" Value="{Binding Audio.VariableQuality, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{Binding Audio.ShowCompressionLevel, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock loc:Loc.Text="FLAC compression level" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Audio.CompressionLevel, Converter={StaticResource Localize}}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="12" StepFrequency="1" Value="{Binding Audio.CompressionLevel, Mode=TwoWay}" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock loc:Loc.Text="Sample rate" Style="{StaticResource CaptionTextStyle}" />
                                        <ComboBox ItemsSource="{Binding Audio.SampleRateOptions}" SelectedItem="{Binding Audio.SelectedSampleRate, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayLabel" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock loc:Loc.Text="Channels" Style="{StaticResource CaptionTextStyle}" />
                                        <ComboBox ItemsSource="{Binding Audio.ChannelOptions}" SelectedItem="{Binding Audio.SelectedChannels, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayLabel" />
                                    </StackPanel>
                                </Grid>
                                <ToggleSwitch loc:Loc.Header="Preserve metadata" IsOn="{Binding CurrentWorkspace.PreserveMetadata, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Video settings -->
                            <StackPanel Spacing="14" Visibility="{Binding IsVideoSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <Border Background="{ThemeResource SubtleSurfaceBrush}" CornerRadius="7" Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Video.ModeTitle, Converter={StaticResource Localize}}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Video.ModeDescription, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="Video codec" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.VideoCodecs}" SelectedItem="{Binding Video.SelectedVideoCodec, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Video.IsVideoCopy, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Encoder" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.VideoEncoders}" SelectedItem="{Binding Video.SelectedVideoEncoder, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" />
                                    <TextBlock Text="{Binding Video.EncoderHint, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Video.ShowRateControl, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Rate control" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.RateControlOptions}" SelectedItem="{Binding Video.SelectedRateControl, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{Binding Video.ShowQuality, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock Text="{Binding Video.QualityLabel, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Video.QualityValue, Converter={StaticResource Localize}}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                    <Slider Minimum="{Binding Video.QualityMinimum}" Maximum="{Binding Video.QualityMaximum}" StepFrequency="1"
                                            Value="{Binding Video.QualityValue, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Video.ShowVideoBitrate, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Video bitrate (kbps)" Style="{StaticResource CaptionTextStyle}" />
                                    <NumberBox Minimum="100" Maximum="200000" SmallChange="100" SpinButtonPlacementMode="Compact"
                                               Value="{Binding Video.VideoBitrate, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4" Visibility="{Binding Video.ShowEncoderPresets, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Encoder preset" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.EncoderPresets}" SelectedItem="{Binding Video.SelectedEncoderPreset, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="Quality preset" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.PresetOptions}" SelectedItem="{Binding Video.SelectedPreset, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock loc:Loc.Text="Audio" Style="{StaticResource CardTitleTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.AudioCodecs}" SelectedItem="{Binding Video.SelectedAudioCodec, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                    <ComboBox ItemsSource="{Binding Video.AudioEncoders}" SelectedItem="{Binding Video.SelectedAudioEncoder, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Visibility="{Binding Video.ShowAudioSettings, Converter={StaticResource BoolToVisibility}}" />
                                    <ComboBox ItemsSource="{Binding Video.AudioBitrateOptions}" SelectedItem="{Binding Video.SelectedAudioBitrate, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel"
                                              Visibility="{Binding Video.ShowAudioBitrate, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid ColumnSpacing="8" Visibility="{Binding Video.ShowAudioSettings, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Video.SampleRateOptions}" SelectedItem="{Binding Video.SelectedAudioSampleRate, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayLabel" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Video.ChannelOptions}" SelectedItem="{Binding Video.SelectedAudioChannels, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayLabel" />
                                    </Grid>
                                </StackPanel>
                                <ToggleSwitch loc:Loc.Header="Resize video" IsOn="{Binding Video.EnableResize, Mode=TwoWay}"
                                              Visibility="{Binding Video.ShowResize, Converter={StaticResource BoolToVisibility}}" />
                                <Grid ColumnSpacing="8" Visibility="{Binding Video.EnableResize, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox loc:Loc.Header="Width" Minimum="2" Maximum="16384" SpinButtonPlacementMode="Compact"
                                               Value="{Binding Video.Width, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" loc:Loc.Header="Height" Minimum="2" Maximum="16384" SpinButtonPlacementMode="Compact"
                                               Value="{Binding Video.Height, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel Spacing="4" Visibility="{Binding Video.EnableResize, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Resize mode" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.ResizeModes}" SelectedItem="{Binding Video.SelectedResizeMode, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <NumberBox loc:Loc.Header="Frame rate (0 = source)" Minimum="0" Maximum="240" SmallChange="1"
                                           SpinButtonPlacementMode="Compact" Value="{Binding Video.FrameRate, Mode=TwoWay}"
                                           Visibility="{Binding Video.ShowFrameRate, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Spacing="4" Visibility="{Binding Video.ShowSubtitles, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock loc:Loc.Text="Subtitles" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Video.SubtitleModes}" SelectedItem="{Binding Video.SelectedSubtitleMode, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" />
                                </StackPanel>
                                <ToggleSwitch loc:Loc.Header="Preserve chapters" IsOn="{Binding Video.PreserveChapters, Mode=TwoWay}"
                                              Visibility="{Binding Video.ShowChapters, Converter={StaticResource BoolToVisibility}}" />
                                <ToggleSwitch loc:Loc.Header="Fast start (web-friendly MP4)" IsOn="{Binding Video.FastStart, Mode=TwoWay}"
                                              Visibility="{Binding Video.ShowFastStart, Converter={StaticResource BoolToVisibility}}" />
                                <ToggleSwitch loc:Loc.Header="Preserve metadata" IsOn="{Binding CurrentWorkspace.PreserveMetadata, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Document settings -->
                            <StackPanel Spacing="14" Visibility="{Binding IsDocumentsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <TextBlock loc:Loc.Text="Document metadata" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBox loc:Loc.Header="Title (optional)" Text="{Binding Documents.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Leave empty to keep the source title" />
                                <TextBox loc:Loc.Header="Author (optional)" Text="{Binding Documents.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Leave empty to keep the source author" />
                                <TextBlock loc:Loc.Text="Pandoc preserves headings, tables, lists, images and Unicode where the target format supports them. PDF output uses the bundled Typst engine; scanned PDFs cannot be converted to text without OCR."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <ToggleSwitch loc:Loc.Header="Preserve metadata" IsOn="{Binding CurrentWorkspace.PreserveMetadata, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- E-book settings -->
                            <StackPanel Spacing="14" Visibility="{Binding IsEbooksSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <TextBlock loc:Loc.Text="E-book metadata" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBox loc:Loc.Header="Title (optional)" Text="{Binding Ebooks.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Leave empty to keep the source title" />
                                <TextBox loc:Loc.Header="Author (optional)" Text="{Binding Ebooks.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="Leave empty to keep the source author" />
                                <TextBox loc:Loc.Header="Language (optional)" Text="{Binding Ebooks.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         loc:Loc.Placeholder="e.g. en, de, fr" />
                                <TextBlock loc:Loc.Text="EPUB output preserves chapters, navigation, images and basic formatting. DRM-protected e-books are detected and refused; PixelForge never attempts to bypass DRM."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <ToggleSwitch loc:Loc.Header="Preserve metadata" IsOn="{Binding CurrentWorkspace.PreserveMetadata, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Archive settings -->
                            <StackPanel Spacing="14" Visibility="{Binding IsArchivesSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="Archive action" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Archives.Actions}" SelectedItem="{Binding Archives.SelectedAction, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <Button loc:Loc.Content="Add folder to package" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{Binding BrowseFolderCommand}"
                                        Visibility="{Binding Archives.IsCreate, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.AutomationId="ConverterAddFolder" />
                                <StackPanel Spacing="4">
                                    <TextBlock loc:Loc.Text="Compression level" Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox ItemsSource="{Binding Archives.CompressionLevels}" SelectedItem="{Binding Archives.SelectedCompressionLevel, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <ToggleSwitch loc:Loc.Header="Preserve directory structure" IsOn="{Binding Archives.PreserveStructure, Mode=TwoWay}" />
                                <TextBlock loc:Loc.Text="A folder is packaged recursively. Create archive accepts individual files or a folder; Repackage and Extract require an archive input."
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                <InfoBar IsOpen="True" Severity="Informational" loc:Loc.Title="Extract to folder"
                                         loc:Loc.Message="Extract uses the central queue, validates every path, enforces entry-count and expanded-size limits, and never deletes the source archive. The format selector is ignored for extraction." />
                            </StackPanel>

                            <!-- Validation -->
                            <StackPanel Spacing="8" Visibility="{Binding CurrentWorkspace.HasIssues, Converter={StaticResource BoolToVisibility}}">
                                <InfoBar IsOpen="{Binding CurrentWorkspace.HasValidationErrors}" Severity="Error"
                                         loc:Loc.Title="Operation needs attention" Message="{Binding CurrentWorkspace.ValidationSummary}" />
                                <InfoBar IsOpen="{Binding CurrentWorkspace.HasValidationWarnings}" Severity="Warning"
                                         loc:Loc.Title="Review warnings" Message="{Binding CurrentWorkspace.ValidationSummary}" />
                                <ItemsControl ItemsSource="{Binding CurrentWorkspace.Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="7" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message, Converter={StaticResource Localize}}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer action bar -->
        <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionHint, Converter={StaticResource Localize}}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentWorkspace.EffectiveOutputDirectory, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button loc:Loc.Content="Open output" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenOutputCommand}" />
                    <Button loc:Loc.Content="Add all to queue" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddToQueueCommand}"
                            IsEnabled="{Binding CanAddToQueue}" AutomationProperties.AutomationId="ConverterAddToQueue" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
