<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelForge.Presentation.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PixelForge.Presentation.Localization"
    Background="Transparent">

    <Grid Padding="28,22,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock loc:Loc.Text="Processing Queue" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="QueueTitle" />
                <TextBlock loc:Loc.Text="Every conversion and upscale runs locally through one verified queue."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          DisplayMemberPath="DisplayLabel" MinWidth="140" Height="34" VerticalAlignment="Center"
                          loc:Loc.AutomationName="Queue filter" />
                <Button loc:Loc.Content="Clear finished" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearTerminalCommand}"
                        AutomationProperties.AutomationId="QueueClearFinished" />
                <Button loc:Loc.Content="History" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenHistoryCommand}"
                        AutomationProperties.AutomationId="QueueOpenHistory" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource InsetCardStyle}" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock loc:Loc.Text="Active" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding ActiveCount, Converter={StaticResource Localize}}" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource InsetCardStyle}" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock loc:Loc.Text="Completed" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding CompletedCount, Converter={StaticResource Localize}}" Style="{StaticResource MetricTextStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource InsetCardStyle}" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock loc:Loc.Text="Failed" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding FailedCount, Converter={StaticResource Localize}}" Style="{StaticResource MetricTextStyle}" Foreground="{ThemeResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource InsetCardStyle}" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock loc:Loc.Text="Filter" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding SelectedFilter.Label, Converter={StaticResource Localize}}" Style="{StaticResource CardTitleTextStyle}" FontSize="14" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource SectionCardStyle}" Visibility="{Binding HasJobs, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="30">
                    <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8FD;" FontSize="28" />
                    </Border>
                    <TextBlock loc:Loc.Text="Nothing queued" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyMessage, Converter={StaticResource Localize}}" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
                    <Button loc:Loc.Content="Open converter" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenConverterClick"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ListView ItemsSource="{Binding VisibleJobs}" SelectionMode="None" Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardStyle}" Padding="16" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource SubtleSurfaceBrush}" Width="40" Height="40" CornerRadius="9" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="18" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title, Converter={StaticResource Localize}}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding OperationText, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding CreatedText, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding ItemCountText, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource SubtleSurfaceBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Grid Width="7" Height="7">
                                                <Ellipse Fill="{ThemeResource AccentPrimaryBrush}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse Fill="{ThemeResource SuccessBrush}" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse Fill="{ThemeResource DangerBrush}" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse Fill="{ThemeResource WarningBrush}" Visibility="{Binding IsInterrupted, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding StateText, Converter={StaticResource Localize}}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenOutputCommand}"
                                                loc:Loc.ToolTip="Open output folder" loc:Loc.AutomationName="Open output folder">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ViewReportCommand}"
                                                loc:Loc.ToolTip="View diagnostic report" loc:Loc.AutomationName="View diagnostic report">
                                            <FontIcon Glyph="&#xE890;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CopyReportCommand}"
                                                loc:Loc.ToolTip="Copy diagnostic report" loc:Loc.AutomationName="Copy diagnostic report">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SaveReportCommand}"
                                                loc:Loc.ToolTip="Save diagnostic report" loc:Loc.AutomationName="Save diagnostic report">
                                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleDetailsCommand}"
                                                loc:Loc.ToolTip="Show items" loc:Loc.AutomationName="Show job items">
                                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CancelCommand}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                loc:Loc.ToolTip="Cancel job" loc:Loc.AutomationName="Cancel job">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RetryCommand}"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                loc:Loc.ToolTip="Retry failed items" loc:Loc.AutomationName="Retry failed items">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveCommand}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                loc:Loc.ToolTip="Remove pending job" loc:Loc.AutomationName="Remove pending job">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText, Converter={StaticResource Localize}}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinWidth="120" TextAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding BatchSummary, Converter={StaticResource Localize}}" Style="{StaticResource CaptionTextStyle}"
                                           Visibility="{Binding BatchSummary, Converter={StaticResource StringToVisibility}}" />

                                <InfoBar IsOpen="{Binding HasError}" Severity="Error" loc:Loc.Title="Job failed" Message="{Binding Error}"
                                         IsClosable="False" />

                                <Expander loc:Loc.Header="Items" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <ListView ItemsSource="{Binding Children}" SelectionMode="None" MaxHeight="300" Padding="0"
                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,4" />
                                                <Setter Property="IsTabStop" Value="False" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="10" Padding="6,7" HorizontalAlignment="Stretch"
                                                      BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding FileName, Converter={StaticResource Localize}}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail, Converter={StaticResource Localize}}" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Error, Converter={StaticResource Localize}}" FontSize="11" Foreground="{ThemeResource DangerBrush}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="3" />
                                                        <TextBlock Text="{Binding ProgressText, Converter={StaticResource Localize}}" FontSize="10" HorizontalAlignment="Right"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ViewReportCommand}"
                                                                loc:Loc.ToolTip="View item diagnostic report" loc:Loc.AutomationName="View item diagnostic report">
                                                            <FontIcon Glyph="&#xE890;" FontSize="12" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CopyReportCommand}"
                                                                loc:Loc.ToolTip="Copy item diagnostic report" loc:Loc.AutomationName="Copy item diagnostic report">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SaveReportCommand}"
                                                                loc:Loc.ToolTip="Save item diagnostic report" loc:Loc.AutomationName="Save item diagnostic report">
                                                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CancelItemCommand}"
                                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                                loc:Loc.ToolTip="Cancel this item" loc:Loc.AutomationName="Cancel this item">
                                                            <FontIcon Glyph="&#xE769;" FontSize="12" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RemoveItemCommand}"
                                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                                loc:Loc.ToolTip="Remove this item without deleting its output"
                                                                loc:Loc.AutomationName="Remove this item from queue">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenOutputCommand}"
                                                                Visibility="{Binding CanOpenOutput, Converter={StaticResource BoolToVisibility}}"
                                                                loc:Loc.ToolTip="Open output" loc:Loc.AutomationName="Open job output">
                                                            <FontIcon Glyph="&#xE8E5;" FontSize="12" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CompareCommand}"
                                                                Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}"
                                                                loc:Loc.ToolTip="Compare before and after" loc:Loc.AutomationName="Compare before and after">
                                                            <FontIcon Glyph="&#xE8AB;" FontSize="12" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
