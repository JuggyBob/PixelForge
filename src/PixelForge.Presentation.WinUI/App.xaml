<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PixelForge.Presentation.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:PixelForge.Presentation.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/ThemeResources.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:StringEmptyToVisibilityConverter x:Key="StringToVisibility" />
            <conv:StringEmptyToVisibilityConverter x:Key="InverseStringToVisibility" Invert="True" />
            <conv:FileSizeConverter x:Key="FileSizeConverter" />
            <conv:DurationConverter x:Key="DurationConverter" />
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <conv:PercentConverter x:Key="PercentConverter" />
            <conv:OperationGlyphConverter x:Key="OperationGlyphConverter" />
            <conv:OperationTextConverter x:Key="OperationTextConverter" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
